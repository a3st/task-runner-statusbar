{
  "name": "task-runner-statusbar",
  "displayName": "Task Runner Status Bar",
  "description": "%extension.description%",
  "version": "0.1.4",
  "publisher": "a3st",
  "author": "a3st",
  "icon": "assets/icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tasks",
    "tasks.json",
    "status bar",
    "task runner"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "taskRunner.selectTask",
        "title": "%command.selectTask%",
        "category": "Task Runner"
      },
      {
        "command": "taskRunner.runTask",
        "title": "%command.runTask%",
        "category": "Task Runner"
      },
      {
        "command": "taskRunner.refreshTasks",
        "title": "%command.refreshTasks%",
        "category": "Task Runner"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -p . --watch",
    "pretest": "npm run compile",
    "test": "node --test",
    "check": "tsc -p . --noEmit",
    "package": "vsce package --allow-missing-repository --no-rewrite-relative-links --out task-runner-statusbar-0.1.4.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.9.3",
    "@types/vscode": "1.85.0",
    "@types/node": "^22.0.0"
  }
}
